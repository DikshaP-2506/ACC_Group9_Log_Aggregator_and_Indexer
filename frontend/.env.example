# Backend API Base URL Configuration:
#
# 1. Local Vite development server (default):
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# 2. Production Docker deployment behind Nginx reverse proxy (recommended for EC2):
# Leave empty so the browser uses relative URLs (/logs/search, /health, /routing)
# routed through Nginx on the same host/domain:
# VITE_API_BASE_URL=
#
# 3. Standalone Frontend (e.g. S3 Static Website / CloudFront pointing to EC2 backend):
# VITE_API_BASE_URL=http://<EC2_PUBLIC_IP>:8000
