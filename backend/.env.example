# Application Settings
APP_NAME=Group9-Log-Aggregator
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# Allowed CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Elasticsearch Connection
# Local development: http://localhost:9200
# Production Docker Compose: http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
LOG_INDEX_NAME=logs
REQUEST_TIMEOUT=10

# Distribution & Routing Configuration
ROUTING_PARTITIONS=partition-0,partition-1,partition-2
VIRTUAL_REPLICAS=100

# AWS S3 Historical Log Archival (Optional for automated cold storage)
AWS_REGION=us-east-1
S3_BUCKET_NAME=group9-log-archives
LOG_RETENTION_DAYS=7
